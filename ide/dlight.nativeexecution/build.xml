<project name="ide/dlight.nativeexecution" default="build" basedir=".">
    <description>Builds, tests, and runs the project org.netbeans.modules.dlight.nativeexecution.</description>
    <import file="../../nbbuild/templates/projectized.xml"/>

    <target name="netbeans" depends="projectized.netbeans">
        <fixcrlf srcdir="${cluster}/bin/nativeexecution" eol="lf">
            <include name="**/*.sh"/>
        </fixcrlf>
    </target>

    <!--
        The Linux helpers ported to Rust (tools/helpers_rs, see its README.md) are
        built from source here for Linux x86_64 and aarch64; every other helper and
        platform still comes from the prebuilt zips in external/. Needs cargo and
        rustup with the musl targets; the targets link with rust-lld. A target that is
        not installed is skipped with a warning, only Linux-x86_64 is required.
    -->
    <property name="extra.module.files"
              value="bin/nativeexecution/Linux-x86_64/killall,bin/nativeexecution/Linux-aarch64/killall"/>

    <target name="-helpers-rs-check">
        <exec executable="cargo" failifexecutionfails="false" resultproperty="helpers_rs.cargo.rc" outputproperty="helpers_rs.cargo.version">
            <arg value="--version"/>
        </exec>
        <fail message="Building the nativeexecution helpers needs Rust: install rustup and cargo, then 'rustup target add x86_64-unknown-linux-musl aarch64-unknown-linux-musl'">
            <condition>
                <not>
                    <equals arg1="${helpers_rs.cargo.rc}" arg2="0"/>
                </not>
            </condition>
        </fail>
    </target>

    <target name="-helpers-rs" depends="-helpers-rs-check">
        <exec executable="sh" dir="tools/helpers_rs" failonerror="true">
            <arg value="build-dist.sh"/>
            <arg file="${cluster}"/>
        </exec>
        <fail message="killall for Linux-x86_64 was not built: rustup target add x86_64-unknown-linux-musl">
            <condition>
                <not>
                    <available file="${cluster}/bin/nativeexecution/Linux-x86_64/killall"/>
                </not>
            </condition>
        </fail>
    </target>

    <target name="release" depends="projectized.release,-helpers-rs"/>

</project>
